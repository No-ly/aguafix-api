# ─────────────────────────────────────────────────────────────
# Copia este archivo a .env y llena los valores.
#   PowerShell:  Copy-Item .env.example .env
# ─────────────────────────────────────────────────────────────

# Puerto donde escucha la API
PORT=3000

# Conexion a Postgres (coincide con compose.yaml)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=aguafix

# ─── Correo (nodemailer) ───────────────────────────────────────
# Para la demo se usa una cuenta de prueba Ethereal (https://ethereal.email).
# Genera una con:  npm run mail:setup   y pega aqui los valores que imprime.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario.generado@ethereal.email
SMTP_PASS=contrasena-generada

# Remitente que ve la cuadrilla en el campo "De:"
MAIL_FROM="AguaFix <no-reply@aguafix.gob.mx>"

# Buzon fijo de la cuadrilla de mantenimiento (siempre recibe el aviso)
MAINTENANCE_CREW_EMAIL=cuadrilla@aguafix.gob.mx
