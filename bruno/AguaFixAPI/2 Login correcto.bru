meta {
  name: 2 Login correcto
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "norte@aguafix.gob.mx",
    "password": "secreta123"
  }
}

assert {
  res.status: eq 200
  res.body.email: eq norte@aguafix.gob.mx
  res.body.password: isUndefined
}
